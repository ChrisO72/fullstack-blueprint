# One local configuration file. Each component validates only its own settings.
# Compose explicitly selects container variables; host tools read this file. 

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
REFRESH_SECRET=replace-with-a-different-random-string-at-least-32-chars
RATE_LIMIT_KEY_SECRET=replace-with-another-random-string-at-least-32-chars

# Local PostgreSQL container initialization. Keep DATABASE_URL in sync for host tools.
POSTGRES_USER=blueprint-user
POSTGRES_PASSWORD=blueprint-password
DATABASE_URL=postgresql://blueprint-user:blueprint-password@127.0.0.1:55432/blueprint
REDIS_URL=redis://localhost:6379

APP_URL=http://localhost:5173

# Optional. Omit all S3_* variables to disable the files feature.
S3_REGION=eu-central-1
S3_BUCKET=blueprint-files
S3_ENDPOINT=http://127.0.0.1:9000
# Optional browser-facing signing endpoint; defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=blueprint-access-key
S3_SECRET_ACCESS_KEY=blueprint-secret-key

# Optional. If the Lettermint environment variables are set, the app can send emails.
# Email is used for account confirmation and password resets.
LETTERMINT_API_KEY=
LETTERMINT_MAIL_FROM=


# Optional Sentry. Run make telemetry-setup, create blueprint/blueprint, then copy its DSN.
# Both URLs are host/browser reachable; Compose rewrites only the server ingress host.
SENTRY_DSN=
SENTRY_PUBLIC_DSN=
SENTRY_ENVIRONMENT=development
# Optional explicit release; otherwise commands derive it from Git or build/<service>/release.json.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# Host-side agent/build tooling only. Never exposed to the browser.
SENTRY_URL=http://localhost:9090
SENTRY_ORG=blueprint
SENTRY_PROJECT=blueprint
SENTRY_AGENT_TOKEN=
SENTRY_UPLOAD_TOKEN=
