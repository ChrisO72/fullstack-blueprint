{
  "name": "fullstack-blueprint",
  "version": "1.1.0",
  "private": true,
  "author": "Chris Opon-Nimoh",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "NODE_ENV=development SENTRY_SERVICE=web node --conditions=development --import tsx --import ./telemetry/register.server.ts ./node_modules/@react-router/dev/bin.cjs dev",
    "dev:worker": "NODE_ENV=development SENTRY_SERVICE=worker node --conditions=development --import tsx --import ./telemetry/register.server.ts worker/index.ts",
    "build": "SENTRY_RELEASE=$(node --import tsx telemetry/release.ts) sh -c 'npm run build:web && npm run build:worker'",
    "build:web": "node --import tsx web/build.ts",
    "build:worker": "node --import tsx worker/build.ts",
    "start": "concurrently --kill-others-on-fail --names web,worker \"npm:start:web\" \"npm:start:worker\"",
    "start:web": "NODE_ENV=production SENTRY_SERVICE=web node --import ./build/web/telemetry.js ./node_modules/@react-router/serve/bin.cjs ./build/web/server/index.js",
    "start:worker": "NODE_ENV=production SENTRY_SERVICE=worker node --import ./build/worker/telemetry.js build/worker/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "check": "npm run format && npm run typecheck && npm run lint && npm test",
    "docker:up": "docker compose up -d database redis storage storage-init",
    "docker:down": "docker compose down --remove-orphans",
    "docker:wipe": "docker compose down -v --remove-orphans",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "test": "vitest run",
    "sentry": "node --import tsx telemetry/sentry/cli.ts",
    "sentry:upload": "node --import tsx telemetry/sentry/upload.ts",
    "build:db": "node --import tsx db/build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-presigned-post": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@sentry/node": "11.2.0",
    "@sentry/react-router": "11.2.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lettermint": "^2.1.0",
    "motion": "^12.43.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sentry": "0.45.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
